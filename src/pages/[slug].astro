---
import Layout from '../layouts/Layout.astro';
import { seoPages, type SeoPage } from '../data/seoPages';

export function getStaticPaths() {
  return seoPages.map((page) => ({
    params: { slug: page.slug },
    props: { page },
  }));
}

const { page } = Astro.props as { page: SeoPage };
const baseUrl = import.meta.env.BASE_URL.endsWith('/')
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const pagePath = `${baseUrl}${page.slug}/`;
const canonicalUrl = new URL(pagePath, Astro.site ?? 'https://aevo-ada-pruefung.de').href;
const appStoreUrl = 'https://apps.apple.com/de/app/aevo-ihk-app-ada-schein/id6763579448';
const withBase = (href: string) => (href.startsWith('/') ? `${baseUrl}${href.slice(1)}` : href);
const siteOrigin = Astro.site ?? 'https://aevo-ada-pruefung.de';
const organizationId = new URL(`${baseUrl}#organization`, siteOrigin).href;
const officialSources = [
  ...(page.slug === 'aevo-app'
    ? [{
        href: appStoreUrl,
        label: 'AEVO Ada im Apple App Store',
        publisher: 'Apple App Store – Plattform-, Anbieter- und Produktangaben',
      }]
    : []),
  {
    href: 'https://www.gesetze-im-internet.de/ausbeignv_2009/',
    label: 'Ausbilder-Eignungsverordnung (AusbEignV)',
    publisher: 'Bundesministerium der Justiz / Bundesamt für Justiz',
  },
  {
    href: 'https://www.bibb.de/dienst/publikationen/de/6991',
    label: 'Die novellierte Ausbilder-Eignungsverordnung',
    publisher: 'Bundesinstitut für Berufsbildung (BIBB)',
  },
];

const articleJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: page.h1,
  description: page.description,
  inLanguage: 'de-DE',
  datePublished: page.slug === 'aevo-app' ? '2026-10-08' : '2026-06-19',
  dateModified: page.updatedDate,
  keywords: page.keywords.split(',').map((keyword) => keyword.trim()),
  author: {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'CFS Mobile Tech',
  },
  publisher: {
    '@type': 'Organization',
    '@id': organizationId,
    name: 'CFS Mobile Tech',
  },
  about: [
    { '@type': 'Thing', name: 'Ausbilder-Eignungsverordnung', alternateName: 'AEVO' },
    { '@type': 'Thing', name: 'Ausbildereignungsprüfung', alternateName: ['AdA-Prüfung', 'ADA-Prüfung'] },
    { '@type': 'Thing', name: 'Ausbilderschein', alternateName: 'ADA-Schein' },
  ],
  citation: officialSources.map((source) => source.href),
  mainEntityOfPage: {
    '@type': 'WebPage',
    '@id': canonicalUrl,
  },
};

const faqJsonLd = page.faqs?.length
  ? {
      '@context': 'https://schema.org',
      '@type': 'FAQPage',
      mainEntity: page.faqs.map((faq) => ({
        '@type': 'Question',
        name: faq.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: faq.answer,
        },
      })),
    }
  : null;

const appJsonLd = page.slug === 'aevo-app'
  ? {
      '@context': 'https://schema.org',
      '@type': 'SoftwareApplication',
      '@id': new URL(`${baseUrl}ios-app/#softwareapplication`, siteOrigin).href,
      name: 'AEVO Ada',
      alternateName: ['AEVO App', 'IHK AEVO App', 'ADA-Schein App', 'Ausbilderschein App'],
      applicationCategory: 'EducationalApplication',
      applicationSubCategory: 'AEVO Prüfungsvorbereitung',
      operatingSystem: 'iOS 16.4 oder neuer, iPadOS 16.4 oder neuer',
      inLanguage: 'de-DE',
      description: page.description,
      url: new URL(`${baseUrl}ios-app/`, siteOrigin).href,
      downloadUrl: appStoreUrl,
      installUrl: appStoreUrl,
      featureList: [
        '700+ prüfungsnahe AEVO-Fragen',
        'Erklärungen zu Antworten',
        'Lernfortschritt nach Themen',
        '90-Minuten-Trainingssimulation',
      ],
      offers: {
        '@type': 'Offer',
        price: '0',
        priceCurrency: 'EUR',
        category: 'Kostenloser Download mit optionalen In-App-Käufen',
      },
      publisher: { '@id': organizationId },
      sameAs: [appStoreUrl],
    }
  : null;
---

<Layout
  title={page.title}
  description={page.description}
  keywords={page.keywords}
  ogType="article"
  publishedDate={page.slug === 'aevo-app' ? '2026-10-08' : '2026-06-19'}
  updatedDate={page.updatedDate}
  breadcrumbs={[
    { name: 'Startseite', href: baseUrl },
    { name: page.h1, href: pagePath },
  ]}
  jsonLd={[articleJsonLd, ...(faqJsonLd ? [faqJsonLd] : []), ...(appJsonLd ? [appJsonLd] : [])]}
>
  <section class="bg-cream py-14 sm:py-20">
    <div class="max-w-5xl mx-auto px-4 sm:px-6">
      <div class="max-w-3xl">
        <p class="inline-flex items-center bg-wine/10 text-wine px-4 py-1.5 rounded-full text-sm font-semibold border border-wine/20 mb-6">
          {page.eyebrow}
        </p>
        <h1 class="font-serif text-4xl sm:text-5xl font-bold text-brown leading-tight mb-6">
          {page.h1}
        </h1>
        <p class="text-lg sm:text-xl text-muted leading-relaxed">
          {page.intro}
        </p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-4 mt-10">
        {page.heroPoints.map((point) => (
          <div class="bg-card border border-cream-border rounded-2xl p-5">
            <div class="w-8 h-8 rounded-lg bg-wine/10 text-wine flex items-center justify-center mb-3">
              <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24" aria-hidden="true">
                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.25" d="M5 13l4 4L19 7" />
              </svg>
            </div>
            <p class="text-sm font-semibold text-brown leading-relaxed">{point}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <article class="py-16 bg-cream-dark/35">
    <div class="max-w-5xl mx-auto px-4 sm:px-6 grid grid-cols-1 lg:grid-cols-[minmax(0,1fr)_18rem] gap-10 items-start">
      <div class="space-y-8">
        {page.sections.map((section) => (
          <section class="bg-card border border-cream-border rounded-2xl p-6 sm:p-8">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brown mb-4">
              {section.title}
            </h2>
            <div class="space-y-4">
              {section.body.map((paragraph) => (
                <p class="text-muted leading-relaxed">{paragraph}</p>
              ))}
            </div>
            {section.bullets && (
              <ul class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3" role="list">
                {section.bullets.map((bullet) => (
                  <li class="flex gap-3 text-sm text-brown">
                    <span class="mt-1.5 w-2 h-2 rounded-full bg-gold flex-shrink-0"></span>
                    <span>{bullet}</span>
                  </li>
                ))}
              </ul>
            )}
          </section>
        ))}

        {page.disclaimer && (
          <p class="text-sm text-muted bg-cream border border-cream-border rounded-xl p-4">
            {page.disclaimer}
          </p>
        )}

        {page.faqs && page.faqs.length > 0 && (
          <section class="bg-card border border-cream-border rounded-2xl p-6 sm:p-8">
            <h2 class="font-serif text-2xl sm:text-3xl font-bold text-brown mb-5">
              Häufige Fragen zur AEVO App
            </h2>
            <div class="space-y-3">
              {page.faqs.map((faq) => (
                <details class="border border-cream-border rounded-xl overflow-hidden group">
                  <summary class="px-5 py-4 cursor-pointer font-semibold text-brown text-sm flex items-center justify-between gap-4 list-none hover:text-wine transition-colors">
                    {faq.question}
                    <span class="text-wine group-open:rotate-45 transition-transform" aria-hidden="true">+</span>
                  </summary>
                  <p class="px-5 pb-5 pt-3 border-t border-cream-border text-sm text-muted leading-relaxed">
                    {faq.answer}
                  </p>
                </details>
              ))}
            </div>
          </section>
        )}

        <section class="bg-cream border border-cream-border rounded-2xl p-6 sm:p-8" aria-labelledby="official-sources">
          <h2 id="official-sources" class="font-serif text-2xl font-bold text-brown mb-3">
            Offizielle Grundlagen und Quellen
          </h2>
          <p class="text-sm text-muted leading-relaxed mb-5">
            Fachliche Angaben werden anhand der geltenden AEVO und öffentlich zugänglicher Informationen des BIBB eingeordnet. Verbindliche organisatorische Details nennt deine zuständige Kammer.
          </p>
          <ul class="space-y-3" role="list">
            {officialSources.map((source) => (
              <li>
                <a
                  href={source.href}
                  class="text-sm font-semibold text-wine hover:text-wine-dark hover:underline"
                  target="_blank"
                  rel="noopener noreferrer"
                >
                  {source.label}
                </a>
                <span class="block text-xs text-muted mt-1">{source.publisher}</span>
              </li>
            ))}
          </ul>
          <p class="text-xs text-muted mt-5">
            Zuletzt inhaltlich geprüft: <time datetime={page.updatedDate}>{page.updatedDate.split('-').reverse().join('.')}</time>
          </p>
        </section>
      </div>

      <aside class="lg:sticky lg:top-24 space-y-5">
        <div class="bg-brown text-cream rounded-2xl p-6">
          <p class="font-serif text-xl font-bold mb-3">{page.ctaTitle}</p>
          <p class="text-sm text-cream/70 leading-relaxed mb-5">{page.ctaText}</p>
          <a
            href={appStoreUrl}
            class="inline-flex items-center justify-center w-full bg-gold text-brown px-5 py-3 rounded-xl font-bold text-sm hover:bg-gold-light transition-colors"
            target="_blank"
            rel="noopener noreferrer"
            data-umami-event="app-store-click"
            data-umami-event-location={`seo-${page.slug}`}
          >
            Im App Store laden
          </a>
        </div>

        <div class="bg-card border border-cream-border rounded-2xl p-5">
          <p class="font-semibold text-brown mb-4">Weiterlesen</p>
          <div class="space-y-4">
            {page.relatedLinks.map((link) => (
              <a href={withBase(link.href)} class="block group">
                <span class="block text-sm font-semibold text-wine group-hover:text-wine-dark transition-colors">
                  {link.label}
                </span>
                <span class="block text-xs text-muted leading-relaxed mt-1">{link.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </article>
</Layout>
